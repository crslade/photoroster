# Copy this to .kamal/secrets and fill in. That file is gitignored, so your
# real values never leave your machine.
#
#     cp .kamal/secrets.example .kamal/secrets
#
# Kamal evaluates this file as shell, so a value can come from the
# environment, a file, or a password manager. `kamal secrets --help` lists
# the supported managers if you would rather not export these by hand.

# A token for your container registry, with permission to push. For GitHub's
# registry that is a personal access token with the write:packages scope.
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD

# The shared passcode people type to reach the site. Generate one with
# `openssl rand -base64 12` and keep it wherever you keep passwords —
# changing it and redeploying signs everyone out.
ROSTER_PASSCODE=$ROSTER_PASSCODE
